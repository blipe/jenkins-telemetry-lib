<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.jenkins.telemetry</groupId>
  <artifactId>jenkins-telemetry-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Jenkins Delivery Telemetry</name>

  <modules>
    <module>telemetry-api</module>
    <module>telemetry-core</module>
    <module>telemetry-collector-file</module>
    <module>telemetry-collector-http-json</module>
    <module>telemetry-collector-otlp-json</module>
    <module>verification</module>
    <module>telemetry-jenkins-plugin</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.telemetry</groupId>
        <artifactId>telemetry-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jenkins.telemetry</groupId>
        <artifactId>telemetry-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jenkins.telemetry</groupId>
        <artifactId>telemetry-collector-file</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jenkins.telemetry</groupId>
        <artifactId>telemetry-collector-http-json</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jenkins.telemetry</groupId>
        <artifactId>telemetry-collector-otlp-json</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <repositories>
    <repository>
      <id>jenkins-releases</id>
      <url>https://repo.jenkins-ci.org/releases/</url>
    </repository>
    <repository>
      <id>jenkins-public</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
</project>
